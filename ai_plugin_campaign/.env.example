# 学生信息接口；本地仅做 UI 联调时可改为 mock。
VITE_AI_EDU_API_MODE=production
VITE_AI_EDU_ADD_URL=https://user.zbrowser.cn/v1/ai/edu/add
VITE_AI_EDU_HAS_BIND_URL=https://user.zbrowser.cn/v1/ai/edu/has-bind
VITE_BOUND_STUDENT_NAME_URL=https://user.zbrowser.cn/v7/user/aip-un
VITE_AI_PRODUCTS_URL=https://cloud.zbrowser.cn/v1/ai/products

# ZERO 浏览器门禁默认开启；仅本地需要绕过下载弹窗时改为 off。
VITE_ZERO_BROWSER_GATE=on

# 学习赛道按钮跳转地址；留空时使用 src/data/activity.ts 中的正式默认地址。
VITE_COURSE_URL=
VITE_DRIVE_URL=
VITE_SEARCH_URL=
VITE_SKIN_URL=
VITE_PDF_URL=
VITE_SUMMARY_COURSE_URL=

# AI 插件赛道日期（北京时间自然日，格式 YYYY-MM-DD）。
# 上传截止日当天仍可上传；次日至初审截止日点击上传会显示活动结束弹窗；初审截止日之后显示作品展示按钮。
VITE_UPLOAD_DEADLINE=2026-08-01
VITE_INITIAL_REVIEW_DEADLINE=2026-09-04
VITE_PLUGIN_GENERATOR_URL=https://www.zbrowser.cn/PluginHub/
